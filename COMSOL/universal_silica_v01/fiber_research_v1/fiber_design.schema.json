{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LSCNS fiber research design v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "family",
    "variant",
    "wavelength_nm",
    "domain_radius_um",
    "parameters",
    "materials",
    "mesh",
    "boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "family": {
      "enum": [
        "index_guiding",
        "solid_pcf",
        "pbgf",
        "kagome",
        "anti_resonant",
        "bragg",
        "mcf",
        "polarization_maintaining"
      ]
    },
    "variant": {
      "type": "string"
    },
    "wavelength_nm": {
      "type": "number",
      "minimum": 250,
      "maximum": 3500
    },
    "domain_radius_um": {
      "type": "number",
      "maximum": 1000,
      "minimum": 1.01
    },
    "parameters": {
      "type": "object",
      "maxProperties": 50,
      "properties": {
        "core_radius_um": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000.0
        },
        "delta_n": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000.0
        },
        "graded_exponent": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000.0
        },
        "trench_inner_um": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000.0
        },
        "trench_outer_um": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000.0
        },
        "trench_delta_n": {
          "type": "number",
          "minimum": -1000000.0,
          "maximum": 1000000.0
        },
        "layer_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "layer_pitch_um": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000.0
        },
        "pitch_um": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000.0
        },
        "d_over_pitch": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 0.95
        },
        "rings": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "defect_cells": {
          "enum": [
            1,
            7,
            19
          ]
        },
        "ellipse_ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000.0
        },
        "core_surround_um": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000.0
        },
        "wall_thickness_um": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000.0
        },
        "curvature": {
          "type": "number",
          "minimum": -1000000.0,
          "maximum": 1000000.0
        },
        "tube_count": {
          "type": "integer",
          "minimum": 4,
          "maximum": 12
        },
        "tube_radius_um": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000.0
        },
        "nested_radius_ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000.0
        },
        "gap_um": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000.0
        },
        "core_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 19
        },
        "trench_width_um": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000.0
        },
        "rod_radius_um": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000.0
        },
        "rod_offset_um": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000.0
        },
        "stress_delta_n": {
          "type": "number",
          "minimum": -1000000.0,
          "maximum": 1000000.0
        }
      },
      "additionalProperties": false
    },
    "materials": {
      "type": "object",
      "required": [
        "background"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "model"
        ],
        "properties": {
          "model": {
            "enum": [
              "pure_silica",
              "air",
              "constant"
            ]
          },
          "n": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 3.5
          },
          "kappa": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.099999
          },
          "source_url": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "model": {
                  "const": "constant"
                }
              }
            },
            "then": {
              "required": [
                "n"
              ]
            }
          }
        ]
      }
    },
    "mesh": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bulk_max_um",
        "through_wall_elements",
        "elements_per_wavelength",
        "curvature_segments",
        "symmetry"
      ],
      "properties": {
        "bulk_max_um": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 20
        },
        "through_wall_elements": {
          "type": "integer",
          "minimum": 3,
          "maximum": 30
        },
        "elements_per_wavelength": {
          "type": "integer",
          "minimum": 4,
          "maximum": 50
        },
        "curvature_segments": {
          "type": "integer",
          "minimum": 24,
          "maximum": 256
        },
        "symmetry": {
          "const": "full"
        },
        "resolution_policy": {
          "enum": [
            "boundary_refined",
            "wavelength"
          ]
        },
        "wall_probe_angles": {
          "type": "integer",
          "minimum": 8,
          "maximum": 128
        },
        "strict_checks": {
          "type": "boolean"
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "thickness_um",
        "strength",
        "order"
      ],
      "properties": {
        "type": {
          "enum": [
            "pec",
            "sbc",
            "pml"
          ]
        },
        "thickness_um": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "strength": {
          "type": "number",
          "minimum": 1e-05,
          "maximum": 30
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "pml"
              }
            }
          },
          "then": {
            "properties": {
              "thickness_um": {
                "exclusiveMinimum": 0
              }
            }
          }
        }
      ]
    },
    "metadata": {
      "type": "object"
    },
    "target_neff": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 3.5
    },
    "solver": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "element_order": {
          "enum": [
            1,
            2
          ]
        },
        "backend": {
          "enum": [
            "beta_squared",
            "companion"
          ]
        },
        "max_dofs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 250000
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 100,
          "maximum": 50000
        },
        "tolerance": {
          "type": "number",
          "minimum": 1e-14,
          "maximum": 1e-05
        },
        "residual_tolerance": {
          "type": "number",
          "minimum": 1e-12,
          "maximum": 1e-05
        },
        "imaginary_noise_floor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1e-06
        },
        "independence_tolerance": {
          "type": "number",
          "minimum": 1e-10,
          "maximum": 0.001
        },
        "degeneracy_tolerance": {
          "type": "number",
          "minimum": 1e-10,
          "maximum": 0.001
        },
        "sbc_iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "family": {
            "const": "index_guiding"
          }
        }
      },
      "then": {
        "properties": {
          "variant": {
            "enum": [
              "step",
              "graded",
              "trench_assisted",
              "w_profile",
              "multilayer"
            ]
          },
          "parameters": {
            "required": [
              "core_radius_um",
              "delta_n"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "family": {
            "const": "solid_pcf"
          }
        }
      },
      "then": {
        "properties": {
          "variant": {
            "enum": [
              "hex",
              "square",
              "lma",
              "high_nonlinearity",
              "elliptic_birefringent"
            ]
          },
          "parameters": {
            "required": [
              "pitch_um",
              "d_over_pitch",
              "rings",
              "defect_cells"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "family": {
            "const": "pbgf"
          }
        }
      },
      "then": {
        "properties": {
          "variant": {
            "enum": [
              "7_cell",
              "19_cell"
            ]
          },
          "parameters": {
            "required": [
              "pitch_um",
              "d_over_pitch",
              "rings",
              "defect_cells",
              "core_surround_um"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "variant": {
                  "const": "7_cell"
                }
              }
            },
            "then": {
              "properties": {
                "parameters": {
                  "properties": {
                    "defect_cells": {
                      "const": 7
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "variant": {
                  "const": "19_cell"
                }
              }
            },
            "then": {
              "properties": {
                "parameters": {
                  "properties": {
                    "defect_cells": {
                      "const": 19
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "family": {
            "const": "kagome"
          }
        }
      },
      "then": {
        "properties": {
          "variant": {
            "enum": [
              "hypocycloid"
            ]
          },
          "parameters": {
            "required": [
              "pitch_um",
              "rings",
              "core_radius_um",
              "wall_thickness_um"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "family": {
            "const": "anti_resonant"
          }
        }
      },
      "then": {
        "properties": {
          "variant": {
            "enum": [
              "single_ring",
              "nanf",
              "dnanf",
              "conjoined_tube",
              "negative_curvature"
            ]
          },
          "parameters": {
            "required": [
              "core_radius_um",
              "tube_count",
              "tube_radius_um",
              "wall_thickness_um"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "family": {
            "const": "bragg"
          }
        }
      },
      "then": {
        "properties": {
          "variant": {
            "enum": [
              "concentric"
            ]
          },
          "parameters": {
            "required": [
              "core_radius_um",
              "layer_count",
              "layer_pitch_um"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "family": {
            "const": "mcf"
          }
        }
      },
      "then": {
        "properties": {
          "variant": {
            "enum": [
              "hex",
              "ring",
              "trench_assisted"
            ]
          },
          "parameters": {
            "required": [
              "core_radius_um",
              "core_count",
              "pitch_um"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "family": {
            "const": "polarization_maintaining"
          }
        }
      },
      "then": {
        "properties": {
          "variant": {
            "enum": [
              "panda",
              "bow_tie",
              "elliptic_core"
            ]
          },
          "parameters": {
            "required": [
              "core_radius_um",
              "delta_n",
              "rod_radius_um",
              "rod_offset_um"
            ]
          }
        }
      }
    }
  ],
  "description": "v0.8.4 validation contract; legacy schema_version=1.0.0 preserved. Python additionally checks cross-field geometry."
}
