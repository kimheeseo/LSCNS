{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "STEP5 vector Bloch input v0.8.7",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "backend",
    "lattice",
    "pitch_um",
    "hole_diameter_over_pitch",
    "n_host",
    "n_air",
    "grid_n",
    "bands",
    "path_points_per_segment",
    "kmesh_n",
    "beta_norms",
    "pwe_cutoff"
  ],
  "properties": {
    "schema": {
      "const": "LSCNS_STEP5_BLOCH_INPUT_V087"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "backend": {
      "const": "vector_pwe"
    },
    "lattice": {
      "enum": [
        "triangular",
        "hexagonal",
        "square",
        "kagome"
      ]
    },
    "input_basis": {
      "type": "string"
    },
    "beta_norms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 5
      }
    },
    "pitch_um": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 1000
    },
    "hole_diameter_over_pitch": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 0.95
    },
    "n_host": {
      "type": "number",
      "minimum": 0.9,
      "maximum": 5
    },
    "n_air": {
      "type": "number",
      "minimum": 0.9,
      "maximum": 5
    },
    "grid_n": {
      "type": "integer",
      "minimum": 10,
      "maximum": 96
    },
    "bands": {
      "type": "integer",
      "minimum": 2,
      "maximum": 24
    },
    "path_points_per_segment": {
      "type": "integer",
      "minimum": 2,
      "maximum": 30
    },
    "kmesh_n": {
      "type": "integer",
      "minimum": 2,
      "maximum": 12
    },
    "pwe_cutoff": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    }
  },
  "additionalProperties": false
}
